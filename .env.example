# ==============================================================================
# Job Aggregator Platform - Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file with secrets to source control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# Database Configuration
# Supabase / PostgreSQL format: postgresql+psycopg://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
# Local SQLite fallback default: sqlite:///./database/jobs.db
DATABASE_URL=sqlite:///./database/jobs.db

# Admin Security (protects manual synchronization and administrative endpoints)
ADMIN_API_KEY=change-this-secure-admin-key-in-production

# External Job Aggregator API Credentials (Optional - for permitted aggregator APIs)
# ADZUNA_APP_ID=your_adzuna_app_id
# ADZUNA_APP_KEY=your_adzuna_app_key
# JOOBLE_API_KEY=your_jooble_api_key
# JSEARCH_RAPIDAPI_KEY=your_rapidapi_key

# Ingestion Scheduling Configuration
SYNC_INTERVAL_HOURS=24
SYNC_TIMEOUT_SECONDS=60
MAX_RETRIES_PER_SOURCE=3
RETRY_BACKOFF_FACTOR=2.0
RATE_LIMIT_DELAY_SECONDS=1.0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="HirePulse - Multi-Source Job Aggregator"

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_SENDER=your_email@gmail.com
